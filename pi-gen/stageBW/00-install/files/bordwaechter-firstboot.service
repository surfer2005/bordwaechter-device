[Unit]
Description=Bordwächter First-Boot (Config von Boot-Partition übernehmen)
Before=bordwaechter.service
ConditionPathExists=!/etc/bordwaechter/.firstboot-done

[Service]
Type=oneshot
ExecStart=/usr/local/bin/bordwaechter-firstboot.sh
ExecStartPost=/usr/bin/touch /etc/bordwaechter/.firstboot-done
RemainAfterExit=true

[Install]
WantedBy=multi-user.target
